// Custom model for shorter foot routes.
// Compared to foot.json this model increases distance_influence, so the route
// calculation penalizes extra distance more.
{
  "distance_influence": 300,
  "priority": [
    { "if": "!foot_access || hike_rating >= 2 || mtb_rating > 2", "multiply_by": "0" },
    { "else": "", "multiply_by": "foot_priority"}
  ],
  "speed": [
    { "if": "true", "limit_to": "foot_average_speed" }
  ]
}
